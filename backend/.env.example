# ==============================================================================
# NutriFlow Backend Environment Configuration (.env.example)
# ==============================================================================

PORT=8000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/nutriflow
JWT_SECRET=nutriflow_jwt_secret_key_12345
FRONTEND_IMAGE_BASE_URL=http://localhost:5173

KITCHEN_LAT=10.0170
KITCHEN_LNG=76.3440

# 1. Google Gemini AI (Free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Message Central (SMS OTP Service)
# Leave blank to use free local demo OTP: 1234
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_AUTH_TOKEN=
